# Copy this file to .env and fill in the values.
# .env is gitignored. Do not commit real keys.
#
# CISA KEV and OSV.dev need no key.

# Required for IP, domain, and file-hash lookups (VirusTotal).
VIRUSTOTAL_API_KEY=

# Local Ollama model for report generation.
OLLAMA_MODEL=qwen3.5:9b

# Optional. Raises the NVD rate limit. CVE lookups work without it.
NVD_API_KEY=
